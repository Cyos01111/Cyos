#!/usr/bin/env bash
set -euo pipefail

# CyosPlay GitHub Privacy Pre-Commit Guard
# Enable locally with: git config core.hooksPath .githooks

STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR)"

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

BLOCKED_PATH_REGEX='(^|/)(\.env(\..+)?|keystore\.properties|signing\.properties|secrets\.properties|local\.properties|debug\.keystore(\.base64)?|cyosplay-release\.keystore|release-integrity\.enc|export/.*)$|\.(keystore|jks|p12|pfx|pk8|pem|key|enc|gpg|asc|cyosvault|sig\.json|apk|aab|sha256|zip|b64|base64)$'

while IFS= read -r file; do
    [ -z "$file" ] && continue
    if [ "$file" = ".env.example" ]; then
        if grep -Eq '^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*=[[:space:]]*[^[:space:]#]+' "$file"; then
            echo "BLOCKED: .env.example must keep empty values only (found non-empty assignment)." >&2
            exit 1
        fi
        continue
    fi

    if echo "$file" | grep -Eq "$BLOCKED_PATH_REGEX"; then
        echo "BLOCKED: Refusing to commit sensitive or binary artifact to GitHub: $file" >&2
        exit 1
    fi
done <<< "$STAGED_FILES"

ADDED_LINES="$(git diff --cached -U0 -- . ':(exclude).githooks/pre-commit' ':(exclude)gradle/verify-release-security.gradle.kts' | grep -E '^\+[^+]' || true)"
if echo "$ADDED_LINES" | grep -Eq '-----BEGIN (RSA |EC )?PRIVATE KEY-----|CYOSENC1:|CYOSPLAY_BUILD_CODE_PASSWORD|CYOSPLAY_RELEASE_(STORE|KEY)_PASSWORD[[:space:]]*=[[:space:]]*[^[:space:]]+|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AIza[0-9A-Za-z_-]{35}|sk_live_[0-9A-Za-z]{20,}'; then
    echo "BLOCKED: Potential private key, keystore password, encrypted password envelope, or token detected in staged diff." >&2
    exit 1
fi

exit 0
