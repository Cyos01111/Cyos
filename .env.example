# Release signing & build integrity secrets for CyosPlay.
# NEVER put real passwords in this file or commit .env to GitHub.
# Configure real values in the AI Studio Secrets panel or GitHub Actions Secrets.

CYOSPLAY_RELEASE_KEYSTORE_PATH=cyosplay-release.keystore
CYOSPLAY_RELEASE_KEY_ALIAS=cyosplay_release
CYOSPLAY_RELEASE_STORE_PASSWORD=CHANGE_ME_RELEASE_STORE_PASSWORD
CYOSPLAY_RELEASE_KEY_PASSWORD=CHANGE_ME_RELEASE_KEY_PASSWORD
CYOSPLAY_BUILD_CODE_PASSWORD=CHANGE_ME_BUILD_CODE_PASSWORD
