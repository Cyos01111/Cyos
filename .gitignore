# Environment, credential properties & local secrets (NEVER commit real or encrypted passwords to GitHub)
.env
.env.*
!.env.example
keystore.properties
signing.properties
secrets.properties
*.secret
*.secrets
*.credentials

# Encrypted envelopes, password blobs & signature keys (NEVER commit to GitHub)
*.enc
*.gpg
*.asc
release-integrity.enc

# Release signing keystores & private keys (keep template debug keystore only)
*.keystore
*.jks
*.p12
*.pfx
*.pk8
*.pem
*.key
cyosplay-release.keystore
!debug.keystore
!debug.keystore.base64

# Built Android packages (build/app/build/.build-outputs remain ignored; export/ visible for local download)
*.aab
*.ap_
*.dex
*release-signed*.zip
.build-outputs/

# Gradle & IDE build caches
.gradle/
build/
app/build/
.kotlin/
.idea/
*.iml
local.properties
captures/
.externalNativeBuild/
.cxx/
.DS_Store
